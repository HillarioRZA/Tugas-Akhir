# ==============================================================================
# .gitignore — PROJECT TA: AI Data Scientist (WISTA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENTIALS, API KEYS & SECRETS (SANGAT KRUSIAL - JANGAN DI-PUSH!)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
gemini_keys.txt
*keys.txt
api_keys_state.json
**/api_keys_state.json
*.pem
*.key
credentials.json
token.json

# ------------------------------------------------------------------------------
# 2. PYTHON VIRTUAL ENVIRONMENTS & COMPILATION ARTIFACTS
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, Coverage & Type Checkers
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. NODE.JS & FRONTEND (REACT + VITE)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
dist/
dist-ssr/
.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------------------------------------------
# 4. RUNTIME STORAGE, CACHE, USER UPLOADS & LOGS
# ------------------------------------------------------------------------------
# User runtime uploads (keep folder structure via .gitkeep)
user_uploads/*
!user_uploads/.gitkeep

# Data runtime folders
data/uploaded/*
!data/uploaded/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vectorstore/*
!data/vectorstore/.gitkeep

# Memory database runtime state (TinyDB)
memory_db.json
**/memory_db.json

# Runtime application logs
logs/*
!logs/.gitkeep
*.log

# Scratchpad / Temporary test files
scratch/
**/scratch/
tmp/
temp/
*.tmp

# ------------------------------------------------------------------------------
# 5. IDEs, EDITORS & OS SYSTEM FILES
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / PyCharm / WebStorm
.idea/
*.iws
*.iml

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 6. SENSITIVE / PERSONAL ACADEMIC DOCUMENTS
# ------------------------------------------------------------------------------
# Jangan push file proposal personal yang memuat NIM / identitas privat
data/dataset/PDF/Proposal*.pdf
**/Proposal*.pdf
