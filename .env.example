# ==============================================================================
# PROJECT TA (AI Data Scientist) - Environment Variables Configuration Template
# Salin berkas ini menjadi '.env' dan isi API Key Anda yang valid.
# JANGAN PERNAH commit berkas '.env' asli ke repository publik!
# ==============================================================================

# Provider LLM yang digunakan ('google', 'openrouter', atau 'groq')
LLM_PROVIDER="google"

# Model untuk ReAct Agent & Vision Interpretation
AGENT_MODEL="gemini-2.5-flash"
INTERPRETATION_MODEL="gemini-2.5-flash"

# Google Gemini API Key (Wajib untuk Gemini 2.5 Flash & Google Embeddings FAISS)
GOOGLE_API_KEY="your_google_gemini_api_key_here"

# Provider Alternatif (Opsional)
OPENAI_API_KEY="your_openai_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"
